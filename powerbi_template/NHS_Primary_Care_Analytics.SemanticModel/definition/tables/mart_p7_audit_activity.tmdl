		variation Variation
			isDefault
			relationship: fdb8e8ce-5f49-4af7-8ea6-d48845fded91
			defaultHierarchy: LocalDateTable_543f85a3-6dc3-4d61-aa1a-e35925e7cb63.'Date Hierarchy'

