	partition mart_p7_audit_activity = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("__NHS_DEMO_AGGREGATE_ROOT__\mart_p7_audit_activity.csv"), [Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				  Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				  Typed = Table.TransformColumnTypes(Promoted, {{"event_day", type date}, {"actor_type", type text}, {"action", type text}, {"event_count", Int64.Type}}, "en-GB")
				in
				  Typed

